# Copy to .env and adjust:  cp .env.example .env

# --- Source database (docker-compose Postgres) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=olist
PG_USER=olist
PG_PASSWORD=olist
PG_SCHEMA=olist

# --- Data lake target: "local" for offline dev, "s3" for AWS ---
LAKE_TARGET=local
LOCAL_LAKE_DIR=./data/lake
S3_BUCKET=
AWS_REGION=us-east-1
AWS_PROFILE=            # olist-ingestion once Phase 2 is applied
