# Copy to .env and adjust:  cp .env.example .env

# --- Source database (docker-compose Postgres) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=olist
PG_USER=olist
PG_PASSWORD=olist
PG_SCHEMA=olist

# --- Data lake target: "local" for offline dev, "s3" for AWS ---
LAKE_TARGET=local
LOCAL_LAKE_DIR=./data/lake
S3_BUCKET=
AWS_REGION=us-east-1
AWS_PROFILE=            # olist-ingestion once Phase 2 is applied

# --- Snowflake (Phase 5) ---
SNOWFLAKE_ACCOUNT=              # org-account identifier, e.g. abcdefg-xy12345
SNOWFLAKE_DATABASE=OLIST
SNOWFLAKE_LOADER_USER=OLIST_LOADER_SVC
SNOWFLAKE_LOADER_ROLE=OLIST_LOADER
SNOWFLAKE_LOADER_WAREHOUSE=OLIST_LOAD_WH
SNOWFLAKE_LOADER_KEY=~/.snowflake/keys/olist_loader_rsa_key.p8
SNOWFLAKE_DBT_USER=OLIST_DBT_SVC
SNOWFLAKE_DBT_KEY=~/.snowflake/keys/olist_dbt_rsa_key.p8
