    <worksheet name='KPI Rating'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Avg Rating</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Products' name='federated.0kfole71cg7ohe165dw890w9zlwz' />
          </datasources>
          <datasource-dependencies datasource='federated.0kfole71cg7ohe165dw890w9zlwz'>
            <column caption='Avg Review Score' datatype='real' name='[AVG_REVIEW_SCORE]' role='measure' type='quantitative' />
            <column caption='Category Label' datatype='string' name='[CATEGORY_LABEL]' role='dimension' type='nominal' />
            <column caption='Avg Rating' datatype='real' default-format='n0.00;-0.00' name='[Calculation_3524828729126922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([AVG_REVIEW_SCORE]) THEN [AVG_REVIEW_SCORE] * [ORDERS] END) / SUM(IF NOT ISNULL([AVG_REVIEW_SCORE]) Then [ORDERS] END)' />
            </column>
            <column caption='Orders' datatype='integer' name='[ORDERS]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3524828729126922]' derivation='User' name='[usr:Calculation_3524828729126922:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0kfole71cg7ohe165dw890w9zlwz].[Action (Category Label)]'>
            <groupfilter function='level-members' level='[CATEGORY_LABEL]' user:ui-action-filter='[Action1_8F6786CBE02F485FA80ECA4EC0D9CAE4]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0kfole71cg7ohe165dw890w9zlwz].[Action (Category Label)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0kfole71cg7ohe165dw890w9zlwz].[usr:Calculation_3524828729126922:qk]' />
            </encodings>
            <customized-label>
