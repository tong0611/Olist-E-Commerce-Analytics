      <column caption='Churned (param)' datatype='boolean' name='[Calculation_3524896486273028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3524896486023171] AND [DAYS_SINCE_LAST_PURCHASE] &gt; [Parameters].[Parameter 3524896484913154]' />
