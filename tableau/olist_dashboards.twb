      </column>
      <column caption='Repeat Rate' datatype='real' default-format='p0.0%' name='[Calculation_3524896487084038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([CUSTOMER_TYPE] = &quot;repeat&quot;, 1, 0)) / SUM(IIF([Calculation_3524896486023171], 1, 0))' />
