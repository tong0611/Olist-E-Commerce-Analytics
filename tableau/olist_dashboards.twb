    <worksheet name='Recency'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customers' name='federated.10h02og0t0atg210vf7wo0wuhvnv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Churn Window (days)' datatype='integer' name='[Parameter 3524896484913154]' param-domain-type='range' role='measure' type='quantitative' value='180'>
              <calculation class='tableau' formula='180' />
              <range granularity='30' max='365' min='30' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10h02og0t0atg210vf7wo0wuhvnv'>
            <column caption='Customer Unique Id' datatype='string' name='[CUSTOMER_UNIQUE_ID]' role='dimension' type='nominal' />
            <column caption='Is Purchaser' datatype='boolean' name='[Calculation_3524896486023171]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[REVENUE_ORDERS] &gt; 0' />
            </column>
            <column caption='Churned (param)' datatype='boolean' name='[Calculation_3524896486273028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3524896486023171] AND [DAYS_SINCE_LAST_PURCHASE] &gt; [Parameters].[Parameter 3524896484913154]' />
              <aliases>
                <alias key='false' value='Active' />
                <alias key='true' value='Churned' />
              </aliases>
            </column>
            <column caption='Days Since Last Purchase' datatype='integer' name='[DAYS_SINCE_LAST_PURCHASE]' role='measure' type='quantitative' />
            <column aggregation='None' caption='Days Since Last Purchase (bin)' datatype='integer' name='[Days Since Last Purchase (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[DAYS_SINCE_LAST_PURCHASE]' peg='0' size='30' />
            </column>
            <column caption='Revenue Orders' datatype='integer' name='[REVENUE_ORDERS]' role='measure' type='quantitative' />
