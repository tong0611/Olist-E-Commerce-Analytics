            <column-instance column='[Calculation_3524896486023171]' derivation='None' name='[none:Calculation_3524896486023171:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3524896486273028]' derivation='None' name='[none:Calculation_3524896486273028:nk]' pivot='key' type='nominal' />
            <column-instance column='[Days Since Last Purchase (bin)]' derivation='None' name='[none:Days Since Last Purchase (bin):ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.10h02og0t0atg210vf7wo0wuhvnv].[none:Calculation_3524896486023171:nk]'>
