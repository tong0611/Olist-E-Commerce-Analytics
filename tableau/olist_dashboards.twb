    <worksheet name='KPI Churn'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Churn Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customers' name='federated.10h02og0t0atg210vf7wo0wuhvnv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Churn Window (days)' datatype='integer' name='[Parameter 3524896484913154]' param-domain-type='range' role='measure' type='quantitative' value='180'>
              <calculation class='tableau' formula='180' />
              <range granularity='30' max='365' min='30' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10h02og0t0atg210vf7wo0wuhvnv'>
            <column caption='Is Purchaser' datatype='boolean' name='[Calculation_3524896486023171]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[REVENUE_ORDERS] &gt; 0' />
            </column>
            <column caption='Churned (param)' datatype='boolean' name='[Calculation_3524896486273028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3524896486023171] AND [DAYS_SINCE_LAST_PURCHASE] &gt; [Parameters].[Parameter 3524896484913154]' />
              <aliases>
                <alias key='false' value='Active' />
                <alias key='true' value='Churned' />
              </aliases>
            </column>
            <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_3524896486682629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_3524896486273028], 1, 0)) / SUM(IIF([Calculation_3524896486023171], 1, 0))' />
            </column>
            <column caption='Days Since Last Purchase' datatype='integer' name='[DAYS_SINCE_LAST_PURCHASE]' role='measure' type='quantitative' />
            <column caption='Revenue Orders' datatype='integer' name='[REVENUE_ORDERS]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3524896486682629]' derivation='User' name='[usr:Calculation_3524896486682629:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.10h02og0t0atg210vf7wo0wuhvnv].[usr:Calculation_3524896486682629:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontsize='28'>&lt;</run>
                <run bold='true' fontsize='28'>[federated.10h02og0t0atg210vf7wo0wuhvnv].[usr:Calculation_3524896486682629:qk]</run>
                <run bold='true' fontsize='28'>&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
